{
  "name": "KewanStore - PHP 8.3 + MariaDB (Alpine)",

  "postCreateCommand": "sh .devcontainer/setup.sh",
  "postStartCommand": "sh .devcontainer/start.sh",

  "forwardPorts": [8000, 3306],

  "portsAttributes": {
    "8000": {
      "label": "KewanStore (PHP built-in server)",
      "onAutoForward": "notify"
    },
    "3306": {
      "label": "MariaDB",
      "onAutoForward": "silent"
    }
  }
}
